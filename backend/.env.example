# Copy to .env and adjust. Never commit .env.

# SQLite (default, local-first). Postgres example:
# SPENDWISE_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/spendwise
SPENDWISE_DATABASE_URL=sqlite:///./spendwise.db

SPENDWISE_CURRENCY=INR
SPENDWISE_TIMEZONE=Asia/Kolkata

# Enables POST /api/dev/seed. Turn off for any shared deployment.
SPENDWISE_DEMO_MODE=true
